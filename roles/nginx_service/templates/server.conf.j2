server {
  listen 0.0.0.0:{{ host.listen_port }} ssl;

  server_name {{ nginx_service_hostname }};

  ssl_certificate /certificates/{{ host.name }}/fullchain.pem;
  ssl_certificate_key /certificates/{{ host.name }}/key.pem;

  location / {
    proxy_pass {{ nginx_service_target }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

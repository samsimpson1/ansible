#!/usr/bin/bash

set -e
set -x
set -o pipefail

sshpass -f /srv/backups/password \
  rsync -e "ssh -p23 -o StrictHostKeyChecking=no" \
  -avz --delete \
  "{{ backup_sync_path }}" \
  "{{ backup_target.user }}@{{ backup_target.hostname }}:{{ backup_sync_name }}/"

/srv/backups/sync-metrics-{{ backup_sync_name }}.sh

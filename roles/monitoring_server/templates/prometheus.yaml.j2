global:
  scrape_interval: {{ monitoring_server_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_server_prometheus_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /alerts.yaml

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node_exporter"
    static_configs:
      - targets:
{% for target in monitoring_server_node_exporter_targets %}
          - "{{ target }}"
{% endfor %}
        labels:
          environment: homelab

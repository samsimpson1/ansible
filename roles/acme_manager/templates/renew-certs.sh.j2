#!/bin/bash

export HETZNER_TOKEN='{{ acme_manager_hetzner_api_token }}'
export LE_WORKING_DIR="/root/.acme.sh"

FAILED_RENEWALS=()

{% for site in sites %}
echo "Attempting renewal for {{ site.name }}..."
if {{ acme_manager_install_dir }}/acme.sh --renew \
  -d {{ site.name }} \
  --dns dns_hetznercloud \
  --cert-file {{ acme_manager_cert_dir }}/{{ site.name }}/cert.pem \
  --key-file {{ acme_manager_cert_dir }}/{{ site.name }}/key.pem \
  --fullchain-file {{ acme_manager_cert_dir }}/{{ site.name }}/fullchain.pem; then
  echo "  ✓ {{ site.name }} renewed successfully"
else
  EXIT_CODE=$?
  if [ $EXIT_CODE -eq 2 ]; then
    echo "  - {{ site.name }} not due for renewal"
  else
    echo "  ✗ {{ site.name }} renewal failed with exit code $EXIT_CODE"
    FAILED_RENEWALS+=("{{ site.name }}")
  fi
fi

{% endfor %}

if [ ${{ '{#FAILED_RENEWALS[@]}' }} -gt 0 ]; then
  echo "Certificate renewal completed with failures at $(date)"
  echo "Failed renewals: ${{ '{FAILED_RENEWALS[*]}' }}"
  exit 1
else
  echo "Certificate renewal completed successfully at $(date)"
  systemctl restart caddy-external caddy-internal caddy-ha
fi

#!/usr/bin/env bash

set -o pipefail
set -e

STATS=$(/srv/backups/restic-util.sh "{{ item.name }}" stats --json --mode raw-data)
SIZE_BYTES=$(jq -r '.total_size' <<< "${STATS}")
SNAPSHOT_COUNT=$(jq -r '.snapshots_count' <<< "${STATS}")

LAST_SNAPSHOT=$(/srv/backups/restic-util.sh "{{ item.name }}" snapshots --json --latest 1 | jq -r '.[0].time' | date +"%s" -f -)

cat <<EOF | curl --data-binary @- https://prometheus-push.int.simpson.id/metrics/job/backup-restic-{{ item.name }}
# HELP backup_restic_last_snapshot Unix time of the latest snapshot in repository
# TYPE backup_restic_last_snapshot gauge
backup_restic_last_snapshot{repository="{{ item.name }}"} ${LAST_SNAPSHOT}
# HELP backup_size_bytes Size of the backup repository in bytes
# TYPE backup_size_bytes gauge
backup_size_bytes{repository="{{ item.name }}",kind="restic"} ${SIZE_BYTES}
# HELP backup_restic_snapshot_count Number of snapshots in repository
# TYPE backup_restic_snapshot_count gauge
backup_restic_snapshot_count{repository="{{ item.name }}"} ${SNAPSHOT_COUNT}
# HELP backup_last_run_timestamp Timestamp of the last successful run
# TYPE backup_last_run_timestamp gauge
backup_last_run_timestamp{repository="{{ item.name }}",kind="restic"} $(date +%s)
EOF
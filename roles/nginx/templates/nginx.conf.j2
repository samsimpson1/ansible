user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
error_log /dev/stderr notice;
worker_shutdown_timeout 30s;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  client_max_body_size 0;
  server_tokens off;
  resolver 127.0.0.11 valid=5s ipv6=off;
  resolver_timeout 2s;
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }
  geo $internal_client {
    default 0;
{% for cidr in nginx_internal_cidrs %}
    {{ cidr }} 1;
{% endfor %}
  }
  # Replace forwarding information at the ingress trust boundary. These apply
  # to custom proxy locations too unless they override proxy_set_header.
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header Forwarded '';
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 3600s;
  # Never put translated ports in application-generated or nginx redirects.
  port_in_redirect off;
  server {
    listen 80 default_server;
    listen 6996 default_server;
    server_name _;
    return 444;
  }
  server {
    listen 443 ssl default_server;
    listen 6997 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
  }
  include /etc/nginx/managed/sites/*.conf;
}

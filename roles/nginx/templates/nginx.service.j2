[Unit]
Description=Nginx ingress ({{ nginx_id }})
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f {{ nginx_id }}
ExecStart={{ nginx_directory }}/start
ExecStop=/usr/bin/docker stop --time 35 {{ nginx_id }}
ExecReload={{ nginx_directory }}/reload
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target

#!/bin/bash
# Disk monitoring script
# Checks disk health, SMART status, and disk usage

set -euo pipefail

HOSTNAME=$(hostname)
CRITICAL_THRESHOLD={{ disk_usage_critical }}
ISSUES_FOUND=0

# Function to log messages
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [DISK] $1"
}

# Function to report issues
report_issue() {
    local severity=$1
    local message=$2
    echo "ALERT|$severity|DISK|$HOSTNAME|$message"
    ISSUES_FOUND=1
}

# Check disk usage for all mounted filesystems
check_disk_usage() {
    log_message "Checking disk usage..."
    
    while read -r filesystem size used avail percent mountpoint; do
        # Skip header line and special filesystems
        if [[ "$filesystem" == "Filesystem" ]] || [[ "$filesystem" =~ ^(tmpfs|devtmpfs|udev|proc|sys) ]]; then
            continue
        fi
        
        # Extract percentage number (remove % sign)
        usage_percent=${percent%\%}
        
        if [[ $usage_percent -ge $CRITICAL_THRESHOLD ]]; then
            report_issue "CRITICAL" "Disk usage critical: $mountpoint is ${usage_percent}% full (threshold: ${CRITICAL_THRESHOLD}%)"
        fi
    done < <(df -h)
}

# Check SMART status for all drives
check_smart_status() {
    log_message "Checking SMART status..."
    
    # Find all block devices (excluding partitions)
    for device in /dev/sd[a-z] /dev/nvme[0-9]n[0-9]; do
        if [[ -b "$device" ]]; then
            # Check if smartctl can access the device
            if smartctl -i "$device" >/dev/null 2>&1; then
                # Get SMART health status
                if ! smartctl -H "$device" | grep -q "PASSED\|OK"; then
                    report_issue "CRITICAL" "SMART health check failed for $device"
                fi
                
                # Check for reallocated sectors
                reallocated=$(smartctl -A "$device" | awk '/Reallocated_Sector_Ct/ {print $10}' || echo "0")
                if [[ -n "$reallocated" ]] && [[ "$reallocated" -gt 0 ]]; then
                    report_issue "CRITICAL" "Reallocated sectors detected on $device: $reallocated"
                fi
                
                # Check for pending sectors
                pending=$(smartctl -A "$device" | awk '/Current_Pending_Sector/ {print $10}' || echo "0")
                if [[ -n "$pending" ]] && [[ "$pending" -gt 0 ]]; then
                    report_issue "CRITICAL" "Pending sectors detected on $device: $pending"
                fi
            fi
        fi
    done
}

# Main execution
main() {
    log_message "Starting disk monitoring on $HOSTNAME"
    
    check_disk_usage
    check_smart_status
    
    if [[ $ISSUES_FOUND -eq 0 ]]; then
        log_message "All disk checks passed"
    fi
    
    log_message "Disk monitoring completed"
}

# Run main function
main "$@"
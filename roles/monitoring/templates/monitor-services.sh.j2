#!/bin/bash
# Service monitoring script
# Checks systemd service status and detects restart loops

set -euo pipefail

HOSTNAME=$(hostname)
RESTART_THRESHOLD={{ service_restart_threshold }}
ISSUES_FOUND=0

# Services to monitor
MONITORED_SERVICES=(
{% for service in monitored_services %}
    "{{ service }}"
{% endfor %}
)

# Function to log messages
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [SERVICE] $1"
}

# Function to report issues
report_issue() {
    local severity=$1
    local message=$2
    echo "ALERT|$severity|SERVICE|$HOSTNAME|$message"
    ISSUES_FOUND=1
}

# Check if a service is active
check_service_status() {
    local service=$1
    
    if ! systemctl is-active --quiet "$service"; then
        local status=$(systemctl is-active "$service" 2>/dev/null || echo "unknown")
        report_issue "CRITICAL" "Service $service is not active (status: $status)"
        return 1
    fi
    
    return 0
}

# Check for service restart loops
check_service_restarts() {
    local service=$1
    
    # Get restart count from the last hour
    local restart_count=$(journalctl -u "$service" --since "1 hour ago" --no-pager -q | grep -c "Started\|Stopped" 2>/dev/null || echo "0")
    # Strip any whitespace/newlines
    restart_count=$(echo "$restart_count" | tr -d '\n\r\t ')
    
    # If we have more than threshold restarts, it might be a restart loop
    if [[ $restart_count -gt $((RESTART_THRESHOLD * 2)) ]]; then
        report_issue "CRITICAL" "Service $service appears to be in a restart loop ($restart_count start/stop events in last hour)"
        return 1
    fi
    
    return 0
}

# Check if a service has failed
check_service_failed() {
    local service=$1
    
    if systemctl is-failed --quiet "$service" 2>/dev/null; then
        report_issue "CRITICAL" "Service $service is in failed state"
        return 1
    fi
    
    return 0
}

# Main service check function
check_service() {
    local service=$1
    log_message "Checking service: $service"
    
    # Check if service exists
    if ! systemctl list-unit-files --type=service | grep -q "^$service.service"; then
        log_message "Service $service not found, skipping"
        return 0
    fi
    
    # Run all checks
    check_service_status "$service"
    check_service_restarts "$service"
    check_service_failed "$service"
}

# Main execution
main() {
    log_message "Starting service monitoring on $HOSTNAME"
    
    for service in "${MONITORED_SERVICES[@]}"; do
        check_service "$service"
    done
    
    if [[ $ISSUES_FOUND -eq 0 ]]; then
        log_message "All service checks passed"
    fi
    
    log_message "Service monitoring completed"
}

# Run main function
main "$@"
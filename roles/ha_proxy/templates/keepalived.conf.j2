vrrp_instance VI_1 {
    state {{ ha_proxy_keepalived_state }}
    interface {{ ha_proxy_interface }}
    virtual_router_id 101
    priority {{ ha_proxy_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ ha_proxy_password }}
    }
    virtual_ipaddress {
        {{ ha_proxy_address }}/{{ ha_proxy_netmask }}
    }

    {% if ha_proxy_keepalived_state == 'BACKUP' %}
    notify_backup "/etc/keepalived/pocket-id-manage.sh stop"
    notify_master "/etc/keepalived/pocket-id-manage.sh start"
    {% endif %}
}

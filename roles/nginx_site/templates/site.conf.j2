server {
  listen {{ '6996' if nginx_site_kind == 'external' else '80' }};
  server_name {{ nginx_site_server_names | join(' ') }};
  return 308 https://$host$request_uri;
}
server {
  listen {{ '6997' if nginx_site_kind == 'external' else '443' }} ssl;
  server_name {{ nginx_site_server_names | join(' ') }};
  ssl_certificate /certificates/{{ nginx_site_certificate }}/fullchain.pem;
  ssl_certificate_key /certificates/{{ nginx_site_certificate }}/key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
{% if nginx_site_upstream | length > 0 %}
  location / {
    # A variable defers lookup until request time, allowing absent backends at
    # startup and refreshing Docker DNS after backend recreation.
    set $backend {{ nginx_site_upstream | regex_replace('/$', '') }};
    proxy_pass $backend$request_uri;
    proxy_ssl_server_name on;
  }
{% endif %}
{{ nginx_site_config | indent(2, true) }}
}

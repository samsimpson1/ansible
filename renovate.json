{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": "**/*.yaml",
      "matchStrings": [
        "\\W+docker_service_image: (?<depName>.+):(?<currentValue>.+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": "group_vars/all/container-images.yaml",
      "matchStrings": [
        "\\W+.+: (?<depName>.+):(?<currentValue>.+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/sabnzbd",
        "ghcr.io/home-operations/qbittorrent",
        "ghcr.io/sct/overseerr",
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/gotson/komga",
        "ghcr.io/unpackerr/unpackerr",
        "slskd/slskd"
      ],
      "groupName": "Media apps"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": [
        "prom/node-exporter",
        "prometheuscommunity/smartctl-exporter",
        "prom/alertmanager",
        "prom/prometheus",
        "prom/pushgateway",
        "grafana/grafana"
      ],
      "groupName": "Monitoring"
    },
    {
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/postgres"
      ],
      "groupName": "Immich"
    }
  ]
}

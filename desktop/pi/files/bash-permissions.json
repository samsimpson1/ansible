{
  "allow": [
    "cat *",
    "cd *",
    "col *",
    "echo *",
    "find *",
    "git diff *",
    "git log *",
    "git ls-tree *",
    "git show *",
    "git status *",
    "go env *",
    "head *",
    "ls *",
    "nl *",
    "printf *",
    "sort *",
    "sox *",
    "soxi *",
    "tail *",
    "true",
    "wc *"
  ],
  "deny": [
    {"command": "rg *", "reason": "Use 'grep' tool instead"},
    {"command": "sed *", "reason": "Use built-in read/edit tools instead"}
  ]
}
